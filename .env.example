# 이 파일은 "어떤 키가 필요한지" 만 알려주는 견본이다.
# 실제 값은 옆의 .env 파일에 넣는다. .env 는 Git 에 올라가지 않는다.
# 이 파일에는 절대 실제 키를 적지 않는다.

# ── 토스증권 Open API (1단계) ────────────────────────
# tossinvest.com(PC 웹) 로그인 > 설정 > Open API 에서 발급
# 같은 화면 하단 "허용 IP 관리" 에 이 서버의 공인 IP 를 반드시 등록해야 한다.
# 등록되지 않은 IP 에서의 호출은 키가 맞아도 403 으로 막힌다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── 공공데이터포털 — KRX 공식 확정 종가 (2단계) ──────
# data.go.kr > 마이페이지 > 데이터활용 > Open API > 활용신청 현황
# "일반 인증키 (Encoding)" 값을 넣는다. 계정당 키 하나로 신청한 모든 API 를 쓴다.
DATA_GO_KR_API_KEY=

# ── OpenDART — 국내 공시·재무 ────────────────────────
# opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# ── SEC EDGAR — 미국 공시 (4단계) ────────────────────
# 키가 아니라 신원 표기다. "이름 이메일" 형식. 없으면 SEC 가 403 으로 막는다.
# 예: SEC_USER_AGENT=Hong Gildong hong@example.com
SEC_USER_AGENT=

# ── Anthropic — 10-K 서술 분석 (6단계) ───────────────
# platform.claude.com > Settings > API Keys
# 발급 직후 같은 콘솔의 Limits 에서 월 상한도 함께 걸어 둔다.
ANTHROPIC_API_KEY=

# 하루에 새로 분석할 수 있는 10-K 문서 수. 비어 있으면 20.
# 한 번 분석한 문서는 DB 에 저장돼 다시 부르지 않으므로, 이 값은 "새 종목을 하루 몇 개까지
# 분석할지"를 뜻한다. 문서 1건에 약 200~300원.
ANALYSIS_DAILY_LIMIT=20

# ── 매크로 스트립 (FRED) ─────────────────────────────
# WTI 유가 하나만 여기서 받는다. 나머지 매크로 지표는 이미 운영 중인 `시황` 프로젝트의
# 공개 결과물을 읽으므로 키가 필요 없다.
# 무료 발급: https://fredaccount.stlouisfed.org/apikeys (32자 영숫자)
# 비워 두면 WTI 만 빠지고 나머지 지표는 정상 표시된다.
FRED_API_KEY=

# ── 사이트 접근 (8단계) ──────────────────────────────
# 외부 공개 시 쓸 공용 아이디와 비밀번호. 둘 다 여기서만 관리한다.
# 고친 뒤에는 서버에서 `bash /opt/stock/deploy/setup_caddy.sh` 를 돌려야 반영된다.
# 비어 있으면 아이디는 view 가 된다.
SITE_USER=view
SITE_PASSWORD=

# ── 앱 오류 알림 ─────────────────────────────────────
# 앱이 500 을 뿜거나 현재가가 멈추면 여기로 메시지를 보낸다.
# 오라클 경보는 "가상머신이 멈춘 것"만 잡는다. 서버는 켜져 있는데 앱만 고장난 경우는
# 이 알림이 잡는다.
#
# 디스코드 웹훅 만들기 (2분, 가입돼 있다면):
#   내 서버 → 채널 옆 ⚙ 편집 → 연동 → 웹후크 → 새 웹후크 → 웹후크 URL 복사
# 슬랙 웹훅도 그대로 넣으면 된다(본문 형식은 주소를 보고 알아서 맞춘다).
#
# 비워 두면 감시는 그대로 돌고 알림만 건너뛴다. 상태는 사이트 화면 위쪽 경고 띠와
# http://129.225.188.89/api/health/detail 에서 볼 수 있다.
ALERT_WEBHOOK_URL=

# ── 앱 설정 ─────────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
