# 이 파일은 "어떤 키가 필요한지" 만 알려주는 견본이다.
# 실제 값은 옆의 .env 파일에 넣는다. .env 는 Git 에 올라가지 않는다.
# 이 파일에는 절대 실제 키를 적지 않는다.

# ── 토스증권 Open API (1단계) ────────────────────────
# tossinvest.com(PC 웹) 로그인 > 설정 > Open API 에서 발급
# 같은 화면 하단 "허용 IP 관리" 에 이 서버의 공인 IP 를 반드시 등록해야 한다.
# 등록되지 않은 IP 에서의 호출은 키가 맞아도 403 으로 막힌다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── OpenDART — 국내 공시·재무 ────────────────────────
# opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# ── SEC EDGAR — 미국 공시 (4단계) ────────────────────
# 키가 아니라 신원 표기다. "이름 이메일" 형식. 없으면 SEC 가 403 으로 막는다.
# 예: SEC_USER_AGENT=Hong Gildong hong@example.com
SEC_USER_AGENT=

# ── Anthropic — 10-K 서술 분석 (6단계) ───────────────
# platform.claude.com > Settings > API Keys
ANTHROPIC_API_KEY=

# ── 사이트 접근 (8단계) ──────────────────────────────
# 외부 공개 시 쓸 공용 비밀번호 하나
SITE_PASSWORD=

# ── 앱 설정 ─────────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
