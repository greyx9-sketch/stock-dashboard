# Caddy 설정 — 접근 비밀번호와 백엔드 연결을 맡는다.
#
# 서버의 /etc/caddy/Caddyfile 자리에 놓는다.
# 아래 "여기에_해시를_붙여넣는다" 한 곳만 실제 값으로 바꾸면 된다.
#
#   서버에서:  caddy hash-password
#   비밀번호를 두 번 입력하면 $2a$14$... 로 시작하는 문자열이 나온다. 그걸 붙여넣는다.
#
# 고칠 때마다:  sudo systemctl reload caddy

# ── 도메인 없이 IP 로 접속하는 설정 ───────────────────────────────────────
#
# :80 은 "어떤 주소로 들어오든 받는다"는 뜻이다. IP 로 접속하므로 도메인을 적을 수 없다.
#
# ⚠️ 이 방식은 **HTTPS 가 아니다.** 비밀번호가 암호화되지 않은 채 오간다.
#    읽기 전용 대시보드이고 공용 비밀번호 하나뿐이라 피해는 제한적이지만,
#    공용 와이파이 같은 데서는 비밀번호가 노출될 수 있다.
#    나중에 도메인이 생기면 이 블록을 아래 주석의 HTTPS 블록으로 바꾸면 된다.
:80 {
	# 사이트 전체에 비밀번호를 건다. 주소를 아는 사람이라도 그냥 들어오지는 못한다.
	# 사용자 이름은 아무거나 좋다. 여기서는 view 로 두었다.
	basic_auth {
		view $2a$14$여기에_해시를_붙여넣는다
	}

	# 실제 처리는 전부 백엔드가 한다. 화면(빌드된 프론트엔드)도 백엔드가 함께 내보내므로
	# 여기서 정적 파일을 따로 다룰 필요가 없다.
	reverse_proxy 127.0.0.1:8000

	# 압축을 켠다. 목록 응답이 수십 KB 라 체감 차이가 크다.
	encode gzip zstd

	log {
		output file /var/log/caddy/stock.log
		format console
	}
}

# ── 나중에 도메인을 붙일 때 ──────────────────────────────────────────────
# 위 `:80 { ... }` 블록을 지우고 아래를 쓴다. 도메인 A 레코드가 서버 IP 를 가리키게 해 두면
# Caddy 가 인증서를 알아서 발급받고 갱신한다. 그때부터 HTTPS 가 된다.
#
# example.com {
# 	basic_auth {
# 		view $2a$14$여기에_해시를_붙여넣는다
# 	}
# 	reverse_proxy 127.0.0.1:8000
# 	encode gzip zstd
# 	log {
# 		output file /var/log/caddy/stock.log
# 		format console
# 	}
# }
