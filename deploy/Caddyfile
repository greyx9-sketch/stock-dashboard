# Caddy 설정 — 누가 무엇을 할 수 있는지와 백엔드 연결을 맡는다.
#
# 서버의 /etc/caddy/Caddyfile 자리에 놓는다.
#
# **이 파일을 손으로 고치지 않는다.** 아래 __SITE_USER__ 와 __PASSWORD_HASH__ 는
# `deploy/setup_caddy.sh` 가 .env 의 SITE_USER·SITE_PASSWORD 를 읽어 채워 넣는 자리다.
# 아이디나 비밀번호를 바꾸려면 .env 만 고치고 그 스크립트를 다시 돌린다:
#
#   서버에서:  bash /opt/stock/deploy/setup_caddy.sh
#
# 비밀번호 평문은 서버 밖으로 나가지 않는다 — 스크립트가 서버 안에서 해시로 바꾼다.

# ── 누가 무엇을 할 수 있는가 (2026-09-01 변경) ──────────────────────────
#
# 예전에는 **사이트 전체에** 비밀번호가 걸려 있었다. 포트폴리오로 링크를 공개하려면
# 비밀번호까지 같이 알려 줘야 해서 그 뜻이 없어진다. 그래서 선을 옮겼다:
#
#   보는 것(GET·HEAD)      → 누구나. 비밀번호 없이 들어온다.
#   바꾸는 것(그 외 전부)   → 주인만. 비밀번호를 묻는다.
#
# **왜 전부 열지 않았나.** 이 사이트에는 보기만 하는 기능만 있는 게 아니다:
#
#   · 사업보고서·10-K 분석 실행 — 문서 1건에 200~340원이 **실제로 나간다**(하루 20건 상한).
#   · 메모·관심종목·일정 — 사용자가 쌓아 온 기록이고, 지우면 되돌릴 수 없다
#     (하루 한 번 백업은 있지만 그 사이에 지워진 것은 사라진다).
#
# 다행히 그 둘이 전부 POST·PUT·DELETE 라 메서드 하나로 선이 그어진다. 보여 주는 것은
# 전부 GET 이므로 방문자는 막히는 데 없이 앱을 다 둘러볼 수 있다.
#
# 주인은 메모를 쓰려고 할 때 브라우저가 한 번 아이디·비밀번호를 묻고, 그다음부터는
# 그 브라우저가 기억한다.

# ── 도메인 없이 IP 로 접속하는 설정 ───────────────────────────────────────
#
# :80 은 "어떤 주소로 들어오든 받는다"는 뜻이다. IP 로 접속하므로 도메인을 적을 수 없다.
#
# ⚠️ 이 방식은 **HTTPS 가 아니다.** 위의 비밀번호(쓰기용)가 암호화되지 않은 채 오간다.
#    보는 것은 어차피 공개라 상관없지만, 주인이 공용 와이파이에서 메모를 쓰면 그때
#    비밀번호가 노출될 수 있다. 나중에 도메인이 생기면 아래 주석의 HTTPS 블록으로 바꾼다.
:80 {
	# GET·HEAD 가 아닌 요청 = 무언가를 바꾸거나 돈을 쓰는 요청.
	@writes {
		not method GET HEAD
	}

	# 그것에만 비밀번호를 건다. 두 자리는 setup_caddy.sh 가 .env 를 읽어 채운다.
	basic_auth @writes {
		__SITE_USER__ __PASSWORD_HASH__
	}

	# 실제 처리는 전부 백엔드가 한다. 화면(빌드된 프론트엔드)도 백엔드가 함께 내보내므로
	# 여기서 정적 파일을 따로 다룰 필요가 없다.
	reverse_proxy 127.0.0.1:8000

	# 압축을 켠다. 목록 응답이 수십 KB 라 체감 차이가 크다.
	encode gzip zstd

	log {
		output file /var/log/caddy/stock.log
		format console
	}
}

# ── 나중에 도메인을 붙일 때 ──────────────────────────────────────────────
# 위 `:80 { ... }` 블록을 지우고 아래를 쓴다. 도메인 A 레코드가 서버 IP 를 가리키게 해 두면
# Caddy 가 인증서를 알아서 발급받고 갱신한다. 그때부터 HTTPS 가 된다.
#
# example.com {
# 	@writes {
# 		not method GET HEAD
# 	}
# 	basic_auth @writes {
# 		__SITE_USER__ __PASSWORD_HASH__
# 	}
# 	reverse_proxy 127.0.0.1:8000
# 	encode gzip zstd
# 	log {
# 		output file /var/log/caddy/stock.log
# 		format console
# 	}
# }
